# ImageMagick script for Group 04
# Ambient files: clean-edge-0011.jpg
# Flash files:   clean-edge-0012.jpg, clean-edge-0013.jpg

"public/123-main-street/clean-edge-0011.jpg" -write mpr:ambient_merge +delete
"public/123-main-street/clean-edge-0012.jpg" "public/123-main-street/clean-edge-0013.jpg" -compose lighten -composite -write mpr:flash_merge +delete

# --- Dark Export: Create darkened flash composite ---
"public/123-main-street/clean-edge-0012.jpg" "public/123-main-street/clean-edge-0013.jpg" -compose darken -composite -write "/Users/davepeloso/Projects/terminal-flazsh/storage/flambient/6546/flambient/flambient_04_tmp.jpg" +delete
# Darkened flash composite saved to: /Users/davepeloso/Projects/terminal-flazsh/storage/flambient/6546/flambient/flambient_04_tmp.jpg

# --- Flambient Blending Steps ---
mpr:ambient_merge -channel B -level 40%,140%,1.0 +channel -write mpr:ambient_mask_alpha +delete
mpr:flash_merge mpr:ambient_mask_alpha -compose CopyOpacity -composite -write mpr:flash_mask +delete
mpr:flash_merge mpr:ambient_merge -compose Luminize -composite -write mpr:luminize_flambient +delete
mpr:luminize_flambient mpr:flash_mask -compose Over -composite -write mpr:ungraded_flambient +delete
mpr:ungraded_flambient mpr:flash_merge -compose Colorize -composite -write "/Users/davepeloso/Projects/terminal-flazsh/storage/flambient/6546/flambient/flambient_04.jpg"
# Final output path: /Users/davepeloso/Projects/terminal-flazsh/storage/flambient/6546/flambient/flambient_04.jpg